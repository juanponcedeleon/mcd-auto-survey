# Live receipt scanning (LayoutLMv3 model in ml/).
# When VITE_USE_ML=true the "Scan Receipt" button sends the camera frame to the
# model via /api/scan-receipt; otherwise it uses the built-in demo fallback.
VITE_USE_ML=false

# URL of the Python inference service (ml/scripts/serve.py).
# Used server-side by api/scan-receipt.js.
ML_SERVICE_URL=http://localhost:8000/extract
